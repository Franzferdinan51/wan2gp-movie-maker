# wan2gp-mcp server endpoint (Streamable HTTP transport)
VITE_WAN2GP_MCP_URL=http://localhost:9100/mcp

# Optional: where the Movie Maker saves its local project files
# (character sheets, storyboards, generated clips)
VITE_PROJECT_ROOT=./projects

# Optional: external image generation (for generating character sheets
# and storyboards from text prompts). Leave blank to skip.
VITE_XAI_API_URL=https://api.x.ai/v1
VITE_XAI_API_KEY=
